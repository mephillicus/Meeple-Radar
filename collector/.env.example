SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Provider LLM in cascata: Gemini (primario), poi Groq, poi OpenRouter.
# Bastano anche solo uno dei tre: i provider senza chiave vengono saltati.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Opzionali: modelli (default gemini-3.6-flash, openai/gpt-oss-120b, openrouter/free)
GEMINI_MODEL=
GROQ_MODEL=
OPENROUTER_MODEL=
# Opzionale: alza i limiti del reader Jina AI usato per le fonti dietro Cloudflare (uplay, Ravensburger, DungeonDice)
JINA_API_KEY=
