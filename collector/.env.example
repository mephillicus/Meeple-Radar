SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Unica chiave LLM: Gemini. Se il modello primario fallisce o non trova nulla si riprova con un
# secondo modello, sulla stessa chiave. Bastano GEMINI_API_KEY: non serve nessun altro provider.
GEMINI_API_KEY=
# Opzionali: i due modelli della cascata (default gemini-3.5-flash-lite poi gemini-3.6-flash).
# Se GEMINI_FALLBACK_MODEL coincide con GEMINI_MODEL il ripiego non viene aggiunto.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
# Opzionale: alza i limiti del reader Jina AI usato per le fonti dietro Cloudflare (uplay, Ravensburger, DungeonDice)
JINA_API_KEY=
